# 제작 요청서(/brief/<토큰>) 설정. 실제 값은 .env.local(로컬)과 Vercel 환경변수에 넣으세요.

# (선택) 요청서 주소의 비밀 토큰. 비우면 src/lib/brief-token.ts의 값을 씁니다.
# 생성: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
# 주소가 새어 나가면 이 값만 바꾸면 기존 링크가 즉시 무효가 됩니다.
BRIEF_TOKEN=

# ── 메일 발송: 아래 둘 중 하나만 설정하면 됩니다 (둘 다 있으면 Gmail 우선) ──

# 1) Gmail
#    Google 계정 → 보안 → 2단계 인증 켜기 → "앱 비밀번호" 발급 (16자리, 띄어쓰기 상관없음)
#    주의: 앱 비밀번호는 메일 계정 권한이라 절대 코드에 넣지 말고 환경변수에만 두세요.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# 2) Resend (https://resend.com, 무료 월 3,000건)
#    도메인 인증 전에는 Resend 가입 메일 주소로만 받을 수 있습니다.
RESEND_API_KEY=
# BRIEF_FROM=WOO 요청서 <brief@woo.it.kr>

# 요청서를 받을 메일 (쉼표로 여러 개 가능). 비우면 GMAIL_USER로 받습니다.
BRIEF_TO_EMAIL=
